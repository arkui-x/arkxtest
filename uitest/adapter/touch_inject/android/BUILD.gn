import("//build/ohos.gni")
import("//test/testfwk/arkxtest/uitest/uitest.gni")

java_library("touchinject_android_java") {
  java_files = [
    "${uitest_adapter_touch_inject_android_java_path}/CurrentActivityHolder.java",
    "${uitest_adapter_touch_inject_android_java_path}/TouchInjector.java",
    "${uitest_adapter_touch_inject_android_java_path}/TouchInjectorBase.java",
  ]
  subsystem_name = "plugins"
  part_name = "touchinject"
}

ohos_combine_jars("touchinject_java") {
  deps = [ ":touchinject_android_java" ]
  subsystem_name = "plugins"
  part_name = "touchinject"
  jar_path = "${root_out_dir}/plugins/uitest/uitest_touchinject_android.jar"
}

ohos_source_set("touchinject_android_jni") {
  sources = [
    "${uitest_adapter_touch_inject_android_path}/java/jni/touch_inject_jni.cpp",
    "${uitest_adapter_touch_inject_android_path}/java/touch_inject_delegate.cpp",
    "${uitest_adapter_touch_inject_android_path}/register_java_plugin.cpp",
    "${uitest_adapter_touch_inject_path}/touch_inject_proxy.cpp",
  ]

  defines = [ "ANDROID_PLATFORM" ]

  deps = [
    ":touchinject_java",
    "//foundation/arkui/ace_engine/adapter/android/build:libarkui_android",
  ]

  public_deps = [ "//plugins/interfaces/native:ace_plugin_util_android" ]

  include_dirs = [
    "//foundation/arkui/ace_engine/",
    "//foundation/arkui/ace_engine/frameworks",
    "//foundation/arkui/ace_engine/interfaces/inner_api/ace_kit/include",
    "//plugins/interfaces/native",
    "${uitest_adapter_touch_inject_path}",
    "${uitest_adapter_touch_inject_path}/android/java",
    "//test/testfwk/arkxtest/uitest/core",
  ]

  subsystem_name = "arkxtest"
  part_name = "uitest"
}
