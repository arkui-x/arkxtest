import("//build/ohos.gni")
import("//test/testfwk/arkxtest/uitest/uitest.gni")

ohos_source_set("display_android_jni") {
  sources = [
    "${uitest_adapter_display_android_path}/display_impl.cpp",
    "${uitest_adapter_display_android_path}/java/jni/display_jni.cpp",
    "${uitest_adapter_display_android_path}/register_java_plugin.cpp",
    "${uitest_adapter_display_path}/display_interface.cpp",
  ]
  include_dirs = [
    "${uitest_core_path}",
    "${uitest_adapter_display_path}",
    "${uitest_adapter_display_android_path}/java/jni",
    "${uitest_adapter_display_android_java_path}",
    "${uitest_adapter_display_android_path}",
    "//foundation/arkui/ace_engine/interfaces/inner_api/ace_kit/include",
    "//plugins/interfaces/native",
  ]

  deps = [ ":display_java" ]

  public_deps = [ "//plugins/interfaces/native:ace_plugin_util_android" ]

  subsystem_name = "arkxtest"
  part_name = "uitest"
}

java_library("display_android_java") {
  java_files = [
    "${uitest_adapter_display_android_java_path}/DisplayPlatform.java",
    "${uitest_adapter_display_android_java_path}/CurrentActivityHolder.java",
  ]
  subsystem_name = "plugins"
  part_name = "display"
}

ohos_combine_jars("display_java") {
  deps = [ ":display_android_java" ]
  subsystem_name = "plugins"
  part_name = "display"
  jar_path = "${root_out_dir}/plugins/uitest/uitest_display_android.jar"
}
